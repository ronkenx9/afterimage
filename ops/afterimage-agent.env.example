# Copy to /etc/afterimage/agent.env on the VPS (chmod 600). Read by the systemd
# unit ops/systemd/afterimage-agent.service. These override the Environment=
# defaults baked into the unit.

# Origin of the deployed AFTERIMAGE app the worker drives (no trailing slash).
AFTERIMAGE_APP_ORIGIN=https://afterimage.app

# Shared secret. Set the SAME value in the app's environment so /api/agent/tick
# only answers this worker (sent as x-afterimage-worker-key). Leave both unset
# only for a private/local endpoint.
AFTERIMAGE_AGENT_WORKER_SECRET=

# Cycle cadence and sizing (the worker clamps interval to 5s..1h, max 1..10).
AGENT_INTERVAL_MS=60000
AGENT_BUDGET=100
AGENT_MAX=3
