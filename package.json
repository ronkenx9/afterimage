{
  "name": "afterimage",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "db:migrate": "node --import tsx scripts/db-migrate.ts",
    "qualify:binance": "node --import tsx scripts/qualify-binance.ts",
    "demo:replay": "node --import tsx scripts/demo-replay.ts"
  },
  "dependencies": {
    "@phosphor-icons/react": "latest",
    "decimal.js": "latest",
    "motion": "latest",
    "next": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
  "devDependencies": {
    "@playwright/test": "latest",
    "@testing-library/jest-dom": "latest",
    "@testing-library/react": "latest",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "eslint": "9.39.3",
    "eslint-config-next": "latest",
    "jsdom": "latest",
    "tsx": "latest",
    "typescript": "6.0.2",
    "vitest": "latest"
  }
}
