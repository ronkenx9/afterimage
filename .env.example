# Public Solana RPC used only for bounded, read-only transaction retrieval.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# Optional. When unset, market reads use Binance's public Spot REST API.
BINANCE_MARKET_BASE_URL=https://api.binance.com

# Execution provider: "paper" (default) or "agentos".
# "agentos" only activates once Agent OS capabilities are bound from an
# authenticated tools/list (docs/binance-tools.json). Unbound => fail-closed.
AFTERIMAGE_EXECUTION_MODE=paper

# Reserved for the qualified standalone MCP OAuth path. Do not use API keys here.
BINANCE_MCP_ENDPOINT=https://agent.binance.com/mcp/agentic

# Autonomous agent — live order execution transport. BOTH must be set to enable
# live tool calls, and even then writes still require a per-action owner approval
# token and irreversible capabilities are refused. Leave unset to stay
# propose-only (the default): the agent surfaces + plans + reverses, never submits.
AFTERIMAGE_MCP_HTTP_URL=
AFTERIMAGE_MCP_BEARER=

# Agent daemon tuning (optional). See `pnpm agent`.
AGENT_INTERVAL_MS=60000
AGENT_BUDGET=100
AGENT_MAX=3

# Add before enabling private hosted accounts.
DATABASE_URL=
SESSION_SECRET=
APP_ORIGIN=http://localhost:3000
